{
  "expo": {
    "name": "SeñaPlay",
    "slug": "senaplay",
    "scheme": "senaplay",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app-icon/icon-claro.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.benjajadev.senaplay",
      "icon": {
        "light": "./assets/app-icon/icon-claro.png",
        "dark": "./assets/app-icon/icon-oscuro.png"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-icon/adaptive-foreground-claro.png",
        "backgroundImage": "./assets/app-icon/adaptive-background-claro.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.benjajadev.senaplay"
    },
    "web": {
      "favicon": "./assets/senaplay_icono_claro.png"
    },
    "plugins": [
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "SeñaPlay necesita acceso a tu galería para cambiar tu foto de perfil."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "SeñaPlay necesita la cámara para reconocer tus señas con la mano."
        }
      ],
      "expo-font"
    ],
    "owner": "benjajadev"
  }
}
